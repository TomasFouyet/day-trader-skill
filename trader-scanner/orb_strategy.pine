// Caja 09:00-10:00 con parcial - la misma regla que trader-scanner/orb.py y la que opera
// trader-alerts/orb_paper.py en la cuenta paper de Alpaca. Para el Strategy Tester de TradingView.
// Investigacion: no es asesoria y no coloca ordenes reales.
//
// Reglas por defecto (las elegidas tras 5 anos de pruebas, README seccion 13):
//  1. Caja: maximo y minimo de las velas de 5 minutos de 09:00 a 10:00 de Nueva York (pre-mercado incluido).
//     En ETF (QQQ, SPY, DIA, IWM) activa el horario extendido (ETH) del grafico; en futuros no hace falta.
//  2. Desde las 10:00, la primera vela que CIERRA fuera de la caja: arriba largo, abajo corto. Ambos lados,
//     sin filtro de medias. Solo velas que cierran hasta las 13:00. Una operacion al dia y ninguna mientras
//     haya otra abierta.
//  3. Entrada al cierre de esa vela. Stop en el otro borde de la caja.
//  4. Al llegar a 1,7R se cierra el 70% y el stop del 30% restante pasa a la entrada (breakeven). El resto
//     no tiene objetivo ("Objetivo" 1,7 = igual al parcial) y no se cierra a las 16:00.
//  5. Lo que siga abierto a los 20 dias de mercado se cierra.
//
// Otras versiones probadas: caja 0900-1030 o 0900-0930, filtro EMA 50/200 de 15 minutos, entrada en el
// retesteo con orden limite, objetivo para el resto (si es mayor que el parcial), cierre a las 16:00.
// Una ruptura sin entrada porque sigue abierta otra operacion se marca con una etiqueta gris ("Ruptura sin
// entrada") y se cuenta en la tabla. Es la regla probada (una a la vez por indice), no un error.
// TradingView no mantiene un largo y un corto a la vez: con "Permitir otra operacion" una senal contraria
// cierra la posicion abierta.
//
// margin_long/short = 0: sin esto TradingView rechaza en silencio las ordenes cuyo valor supera el
// capital (con una caja chica, arriesgar 1% puede ser comprar 3 veces el capital; un contrato de NQ vale
// mas de 500.000 USD), y la estrategia hace muy pocas operaciones.
//
//@version=6
strategy("Caja 9:00-10:00 (parcial)", overlay = true, initial_capital = 100000,
     process_orders_on_close = true, pyramiding = 20, margin_long = 0, margin_short = 0,
     commission_type = strategy.commission.percent, commission_value = 0.01, slippage = 1,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

boxSess    = input.session("0900-1000", "Caja (hora de Nueva York)")
tradeSess  = input.session("1000-1300", "Ventana de entradas (hora de Nueva York)")
tpR        = input.float(1.7, "Objetivo (R)", minval = 0.5, step = 0.1)
useFilter  = input.bool(false, "Filtro EMA rapida/lenta")
filterTf   = input.timeframe("15", "Temporalidad del filtro")
fastLen    = input.int(50, "EMA rapida", minval = 1)
slowLen    = input.int(200, "EMA lenta", minval = 2)
allowLong  = input.bool(true, "Permitir largos")
allowShort = input.bool(true, "Permitir cortos")
firstOnly  = input.bool(false, "Solo la primera ruptura del dia")
entryMode  = input.string("Cierre de la ruptura", "Entrada", options = ["Cierre de la ruptura", "Retesteo (limite)"])
allowStack = input.bool(false, "Permitir otra operacion con una ya abierta")
usePartial = input.bool(true, "Cerrar un parcial y mover el stop a la entrada")
partialR   = input.float(1.7, "Parcial a (R)", minval = 0.1, step = 0.1)
partialPct = input.float(70, "Parcial (% de la posicion)", minval = 1, maxval = 99)
flatEod    = input.bool(false, "Cerrar a la hora de cierre si sigue abierta")
flatH      = input.int(16, "Hora de cierre (NY)", minval = 0, maxval = 23)
flatM      = input.int(0, "Minuto de cierre", minval = 0, maxval = 59)
minBoxBars = input.int(6, "Velas minimas en la caja", minval = 1)
sizeMode   = input.string("Riesgo %", "Tamano", options = ["Riesgo %", "Cantidad fija"])
riskPct    = input.float(0.25, "Riesgo por operacion (% del capital)", minval = 0.1, step = 0.1)
fixedQty   = input.float(1, "Cantidad fija (contratos o acciones)", minval = 0.001)
fromTime   = input.time(timestamp("2020-01-01T00:00:00"), "Desde")
maxDays    = input.int(20, "Cerrar despues de (dias de mercado, 0 = nunca)", minval = 0)
drawBox    = input.bool(true, "Dibujar la caja")
boxColor   = input.color(color.new(color.blue, 85), "Color de la caja")
showSkips  = input.bool(true, "Marcar las rupturas sin entrada (y por que)")
showExits  = input.bool(true, "Marcar cada salida en su precio real (en R)")

TZ = "America/New_York"

inBox   = not na(time(timeframe.period, boxSess, TZ))
inTrade = not na(time(timeframe.period, tradeSess, TZ))
nyDay   = dayofmonth(time, TZ)
newDay  = nyDay != nyDay[1]
flatT   = timestamp(TZ, year(time, TZ), month(time, TZ), dayofmonth(time, TZ), flatH, flatM)

var float boxHi = na
var float boxLo = na
var int   boxBars = 0
var bool  traded = false
var int   firstDir = 0
var bool  sawBreak = false
var bool  boxCounted = false
var float entryPx = na
var float stopPx = na
var float tgtPx = na
var float riskPts = na
var box   bx = na
var line  lnHi = na
var line  lnLo = na

// Diagnostico: donde se pierden los dias
var int nDays = 0        // dias con caja valida
var int nBreakDays = 0   // dias con al menos un cierre fuera de la caja
var int nBlocked = 0     // rupturas descartadas por el filtro o por el lado apagado
var int nOrders = 0      // entradas enviadas
var int nBusy = 0        // dias con ruptura sin entrada porque seguia abierta otra operacion
var bool skipNoted = false

if newDay
    boxHi := na
    boxLo := na
    boxBars := 0
    traded := false
    firstDir := 0
    sawBreak := false
    boxCounted := false
    skipNoted := false
    bx := na
    lnHi := na
    lnLo := na

if inBox
    boxHi := na(boxHi) ? high : math.max(boxHi, high)
    boxLo := na(boxLo) ? low : math.min(boxLo, low)
    boxBars += 1
    if drawBox
        if na(bx)
            bx := box.new(time, boxHi, time_close, boxLo, xloc = xloc.bar_time, border_color = color.new(color.blue, 30),
                 bgcolor = boxColor)
        else
            box.set_top(bx, boxHi)
            box.set_bottom(bx, boxLo)
            box.set_right(bx, time_close)

// EMAs de 15 minutos ya cerradas al cierre de esta vela (sin mirar al futuro en el historico)
[emaF, emaS] = request.security(syminfo.tickerid, filterTf, [ta.ema(close, fastLen), ta.ema(close, slowLen)],
     lookahead = barmerge.lookahead_off)
trendUp = emaF > emaS
trendDn = emaF < emaS

boxReady = inTrade and not inBox and boxBars >= minBoxBars and not na(boxHi)

if boxReady and not boxCounted
    boxCounted := true
    nDays += 1
    if drawBox
        lnHi := line.new(time, boxHi, flatT, boxHi, xloc = xloc.bar_time, color = color.new(color.teal, 0),
             style = line.style_dashed)
        lnLo := line.new(time, boxLo, flatT, boxLo, xloc = xloc.bar_time, color = color.new(color.orange, 0),
             style = line.style_dashed)

brkUp = boxReady and close > boxHi
brkDn = boxReady and close < boxLo
isFirst = firstDir == 0
if (brkUp or brkDn) and firstDir == 0
    firstDir := brkUp ? 1 : -1
if (brkUp or brkDn) and not sawBreak
    sawBreak := true
    nBreakDays += 1

canTrade = (allowStack or strategy.opentrades == 0) and not traded and time >= fromTime
longOk  = canTrade and brkUp and allowLong and (not useFilter or trendUp) and (not firstOnly or isFirst)
shortOk = canTrade and brkDn and allowShort and (not useFilter or trendDn) and (not firstOnly or isFirst)
if canTrade and (brkUp or brkDn) and not longOk and not shortOk
    nBlocked += 1

// Ruptura valida pero sin entrada porque sigue abierta una operacion de antes (por defecto el 30% que queda
// tras el parcial puede seguir hasta 20 dias): es la regla, no un error. Se marca en el grafico.
busy = not allowStack and strategy.opentrades > 0 and not traded and time >= fromTime
if busy and (brkUp or brkDn) and not skipNoted
    skipNoted := true
    nBusy += 1
    if showSkips
        t0 = strategy.opentrades.entry_time(0)
        side0 = strategy.opentrades.size(0) > 0 ? "larga" : "corta"
        label.new(bar_index, brkUp ? high : low, "Ruptura sin entrada:\nsigue abierta la " + side0 + " del " +
             str.format_time(t0, "dd/MM", TZ), color = color.new(color.gray, 10), textcolor = color.white,
             style = brkUp ? label.style_label_down : label.style_label_up, size = size.small)

qtyFor(r) =>
    float q = fixedQty
    if sizeMode == "Riesgo %"
        q := math.floor(strategy.equity * riskPct / 100.0 / (r * syminfo.pointvalue))
        q := math.max(q, 1)
    q

// Un id por dia, para que cada operacion tenga su propia salida aunque haya otras abiertas
var string pendId = na
var int nFilled = 0
var map<string, float> riskById = map.new<string, float>()
var map<string, float> qtyById = map.new<string, float>()
var map<string, float> runTgtById = map.new<string, float>()
var map<string, bool> beDone = map.new<string, bool>()
var float showStop = na   // stop vigente de la ultima operacion (pasa a la entrada tras el parcial)
var float showTgt = na    // proximo objetivo (el parcial; despues, el del resto si lo hay)
retest = entryMode == "Retesteo (limite)"
if longOk or shortOk
    dir = longOk ? 1 : -1
    tid = (dir > 0 ? "L" : "C") + str.format("{0,date,yyyyMMdd}", time)
    entryPx := retest ? (dir > 0 ? boxHi : boxLo) : close
    stopPx := dir > 0 ? boxLo : boxHi
    riskPts := math.abs(entryPx - stopPx)
    tgtPx := entryPx + dir * tpR * riskPts
    q = qtyFor(riskPts)
    riskById.put(tid, riskPts)
    qtyById.put(tid, q)
    if retest
        // orden limite en el borde roto de la caja; se cancela si no se llena dentro de la ventana
        strategy.entry(tid, dir > 0 ? strategy.long : strategy.short, qty = q, limit = entryPx)
        pendId := tid
    else
        strategy.entry(tid, dir > 0 ? strategy.long : strategy.short, qty = q)
    if usePartial
        // parcial: partialPct % al llegar a partialR; el resto va al objetivo si es mayor, si no al cierre
        float runTgt = tpR > partialR ? tgtPx : na
        runTgtById.put(tid, runTgt)
        strategy.exit(tid + "p", tid, qty_percent = partialPct, stop = stopPx, limit = entryPx + dir * partialR * riskPts)
        strategy.exit(tid + "r", tid, stop = stopPx, limit = runTgt)
        showTgt := entryPx + dir * partialR * riskPts
    else
        strategy.exit(tid + "x", tid, stop = stopPx, limit = tgtPx)
        showTgt := tgtPx
    showStop := stopPx
    traded := true
    nOrders += 1

// despues del parcial, el stop del resto pasa al precio de entrada (breakeven)
if usePartial and strategy.opentrades > 0
    for i = 0 to strategy.opentrades - 1
        eid = strategy.opentrades.entry_id(i)
        q0 = qtyById.get(eid)
        if not na(q0) and math.abs(strategy.opentrades.size(i)) < q0 and not beDone.contains(eid)
            strategy.exit(eid + "r", eid, stop = strategy.opentrades.entry_price(i), limit = runTgtById.get(eid))
            beDone.put(eid, true)
            showStop := strategy.opentrades.entry_price(i)
            showTgt := runTgtById.get(eid)

// lo que siga abierto a los maxDays dias de mercado se cierra (a partir de las 15:30)
var int dayCount = 0
var map<string, int> dayById = map.new<string, int>()
if newDay
    dayCount += 1
if (longOk or shortOk)
    dayById.put((longOk ? "L" : "C") + str.format("{0,date,yyyyMMdd}", time), dayCount)
late = time_close >= timestamp(TZ, year(time, TZ), month(time, TZ), dayofmonth(time, TZ), 15, 30)
if maxDays > 0 and late and strategy.opentrades > 0
    for i = 0 to strategy.opentrades - 1
        eid = strategy.opentrades.entry_id(i)
        d0 = dayById.get(eid)
        if not na(d0) and dayCount - d0 >= maxDays
            strategy.close(eid, comment = "dias")

// la orden limite pendiente se cancela al salir de la ventana de entradas
if not na(pendId) and not inTrade and not inBox
    strategy.cancel(pendId)
    pendId := na

if flatEod and strategy.position_size != 0 and time_close >= flatT and time < flatT
    strategy.close_all(comment = "cierre")

// Resultado en R antes de comisiones (comparable con orb.py), operacion por operacion
// (con parcial, cada operacion se cierra en dos partes: se suman ponderadas por su tamano)
var float sumR = 0.0
var int nTr = 0
var int nWin = 0
var int seen = 0
var map<string, float> accR = map.new<string, float>()
var map<string, float> accF = map.new<string, float>()
while seen < strategy.closedtrades
    eid = strategy.closedtrades.entry_id(seen)
    rk = riskById.get(eid)
    q0 = qtyById.get(eid)
    if not na(rk) and rk > 0 and not na(q0) and q0 > 0
        d = strategy.closedtrades.size(seen) > 0 ? 1.0 : -1.0
        r = (strategy.closedtrades.exit_price(seen) - strategy.closedtrades.entry_price(seen)) * d / rk
        f = math.abs(strategy.closedtrades.size(seen)) / q0
        // TradingView dibuja la flecha de la orden debajo o encima de la vela, no en el precio: esta marca
        // queda en el precio real de la salida
        if showExits
            label.new(strategy.closedtrades.exit_time(seen), strategy.closedtrades.exit_price(seen),
                 (r >= 0 ? "+" : "") + str.tostring(r, "#.0#") + "R", xloc = xloc.bar_time,
                 style = label.style_label_left, size = size.tiny, textcolor = color.white,
                 color = r > 0.05 ? color.new(color.green, 15) : r < -0.05 ? color.new(color.red, 15) : color.new(color.gray, 15))
        a = nz(accR.get(eid)) + r * f
        b = nz(accF.get(eid)) + f
        accR.put(eid, a)
        accF.put(eid, b)
        if b >= 0.999
            sumR += a
            nTr += 1
            nWin += a > 0 ? 1 : 0
    seen += 1

var table tb = table.new(position.bottom_right, 2, 9, bgcolor = color.new(color.black, 20), border_width = 1)
cell(row, name, value) =>
    table.cell(tb, 0, row, name, text_color = color.white, text_size = size.small)
    table.cell(tb, 1, row, value, text_color = color.white, text_size = size.small)
if barstate.islast
    cell(0, "Dias con caja", str.tostring(nDays))
    cell(1, "Dias con ruptura", str.tostring(nBreakDays))
    cell(2, "Rupturas filtradas", str.tostring(nBlocked))
    cell(3, retest ? "Ordenes limite enviadas" : "Entradas enviadas", str.tostring(nOrders))
    cell(4, "Operaciones cerradas", str.tostring(nTr))
    cell(5, "Ganadoras", nTr > 0 ? str.tostring(100.0 * nWin / nTr, "#.0") + "%" : "-")
    cell(6, "R promedio", nTr > 0 ? str.tostring(sumR / nTr, "#.000") : "-")
    cell(7, "R total", str.tostring(sumR, "#.0"))
    cell(8, "Rupturas con otra abierta", str.tostring(nBusy))
    if nDays == 0
        label.new(bar_index, high, "Sin velas en la caja: usa velas de 5 min y activa el horario extendido (ETH)",
             color = color.red, textcolor = color.white, style = label.style_label_down)

plot(strategy.position_size != 0 ? showStop : na, "Stop vigente", color.red, 1, plot.style_linebr)
plot(strategy.position_size != 0 ? showTgt : na, "Proximo objetivo", color.lime, 1, plot.style_linebr)
plot(useFilter ? emaF : na, "EMA rapida (15m)", color.new(color.yellow, 40))
plot(useFilter ? emaS : na, "EMA lenta (15m)", color.new(color.purple, 40))
